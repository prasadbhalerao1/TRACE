# ==============================================================================
# AI Talent Intelligence & Recruitment Platform — Environment Variables
# Copy to .env and fill in real values. .env itself should stay gitignored.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM — single provider only (doc 07 §5). No Groq, no second vendor.
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Model routing (doc 07 §5) — Haiku for high-volume/low-ambiguity, Sonnet for judgment calls
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_JUDGMENT=claude-sonnet-4-6

# ------------------------------------------------------------------------------
# Database — local docker-compose Postgres by default; swap to a managed provider
# (e.g. Neon) by pointing DATABASE_URL at it and setting DATABASE_SSL_REQUIRED=true.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/talent_platform
DATABASE_SSL_REQUIRED=false

# ------------------------------------------------------------------------------
# Cache / task queue — Redis (local Docker for dev, Upstash free tier for prod)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Vector DB — Qdrant (local Docker for dev, Qdrant Cloud free tier for prod)
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# Embeddings — self-hosted, free (doc 00 §2). No paid embedding API key needed.
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ------------------------------------------------------------------------------
# Auth — Clerk (decided in .agents/decisions.md; free tier)
# ------------------------------------------------------------------------------
AUTH_PROVIDER=clerk
AUTH_PUBLISHABLE_KEY=
AUTH_SECRET_KEY=

# Clerk SDK-specific var names (frontend reads NEXT_PUBLIC_*, backend verifies JWTs via JWKS)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=

# ------------------------------------------------------------------------------
# GitHub OAuth — per-candidate token, never a shared server token (doc 08 §11)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# ------------------------------------------------------------------------------
# File storage — single provider only (doc 00 §2). No Cloudflare R2.
# ------------------------------------------------------------------------------
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# Observability — Langfuse (self-host or free cloud tier) + Sentry (free tier)
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

# ------------------------------------------------------------------------------
# App config
# ------------------------------------------------------------------------------
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Consent / data policy defaults (doc 06 §5, doc 03 §3)
INTERVIEW_CONSENT_REQUIRED=true
# Note: interview audio is never stored (doc 00 §5) — transcript only, so there is
# no INTERVIEW_AUDIO_RETENTION_DAYS variable here by design.

# ------------------------------------------------------------------------------
# Rate limiting (slowapi + Redis token-bucket, doc 07 §7)
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
